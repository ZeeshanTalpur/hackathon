# Smart Public Transport & Bus Tracking Platform - Karachi
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase
# Project settings -> Data API / API keys
# ---------------------------------------------------------------------------

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Bypasses Row Level Security completely.
# No NEXT_PUBLIC_ prefix, so Next.js will never ship it to the client.
# Used by scripts/seed-auth.mjs and by the GPS feed write path.
# If you do not need server-side writes yet, leave it blank.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Maps
# Needs the NEXT_PUBLIC_ prefix because the Maps JavaScript API runs in the
# browser. Restrict the key by HTTP referrer and enable only the APIs you use
# (Maps JavaScript API), otherwise a public key is abusable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-browser-key
